# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "plist"

default_platform(:ios)

platform :ios do
  private_lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_PRIVATE_KEY"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Install or renew App Store signing assets on a CI runner"
  lane :prepare_ci_signing do
    keychain_name = "bodybuddies-ci"
    keychain_password = ENV.fetch("CI_KEYCHAIN_PASSWORD", "temporary-ci-keychain")
    api_key = load_asc_api_key
    app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    bundle_id = Spaceship::ConnectAPI::BundleId.find(app_identifier)
    UI.user_error!("Bundle ID #{app_identifier} was not found") unless bundle_id

    capability_types = Spaceship::ConnectAPI::BundleIdCapability::Type
    current_capabilities = bundle_id.get_capabilities
    UI.message(
      "Current App ID capabilities: " \
      "#{current_capabilities.map(&:capability_type).sort.join(', ')}"
    )

    required_capabilities = [
      capability_types::PUSH_NOTIFICATIONS,
      capability_types::APPLE_ID_AUTH
    ]
    missing_capabilities = required_capabilities -
      current_capabilities.map(&:capability_type)
    UI.user_error!(
      "App ID is missing capabilities: #{missing_capabilities.join(', ')}"
    ) unless missing_capabilities.empty?

    delete_keychain(name: keychain_name) if File.exist?(
      File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    )
    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )
    match(
      api_key: api_key,
      type: "appstore",
      readonly: false,
      force: true,
      app_identifier: CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier),
      git_url: ENV.fetch(
        "MATCH_GIT_URL",
        "https://github.com/TeamBocean/bodybuddiesapp.git"
      ),
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      keychain_name: keychain_name,
      keychain_password: keychain_password,
      renew_expired_certs: true
    )

    profile_path = ENV.fetch(
      "sigh_#{app_identifier}_appstore_profile-path"
    )
    installed_profiles = Dir.glob(
      File.join(File.dirname(profile_path), "*.mobileprovision")
    )
    stale_profiles = installed_profiles.reject do |candidate|
      File.expand_path(candidate) == File.expand_path(profile_path)
    end
    stale_profiles.each { |candidate| File.delete(candidate) }
    UI.message(
      "Removed #{stale_profiles.length} stale provisioning profile(s); " \
      "using #{File.basename(profile_path)}"
    )

    profile = Plist.parse_xml(
      sh("security", "cms", "-D", "-i", profile_path)
    )
    profile_entitlements = profile.fetch("Entitlements", {})
    aps_environment = profile_entitlements["aps-environment"]
    apple_sign_in = profile_entitlements["com.apple.developer.applesignin"]

    UI.user_error!(
      "Provisioning profile is missing production Push Notifications"
    ) unless aps_environment == "production"
    UI.user_error!(
      "Provisioning profile is missing Sign in with Apple"
    ) unless Array(apple_sign_in).include?("Default")

    UI.success(
      "Provisioning profile contains production APNs and Sign in with Apple"
    )
  end

  desc "Upload an already-built IPA to TestFlight"
  lane :upload_ipa do |options|
    ipa_path = options[:ipa_path]
    UI.user_error!("Pass ipa_path:/absolute/path/to/app.ipa") if ipa_path.to_s.empty?
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    upload_to_testflight(
      api_key: load_asc_api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
